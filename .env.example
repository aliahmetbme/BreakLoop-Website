# Leave unset for local preview. No production canonical is emitted without HTTPS URL.
# NEXT_PUBLIC_SITE_URL=https://your-verified-domain.example
# Dedicated iCloud Mail alias created for BreakLoop support.
# Operational blocker: iCloud storage (5 GB / 5 GB full) must be cleared and real inbound/outbound mail + From-address ("breakloopSupport@icloud.com") verified before uncommenting and setting SUPPORT_EMAIL_MONITORED=true.
# Never configure the developer's primary personal email (aliahmet44@icloud.com) as public support contact.
# NEXT_PUBLIC_SUPPORT_EMAIL=breakloopSupport@icloud.com
# Proposed individual developer legal name (confirm against Apple Developer legal identity before publication; do not invent a company name):
# NEXT_PUBLIC_OPERATOR=Ali Ahmet Erdoğdu
# Enable only after RELEASE-CHECKLIST.md Website Publication Readiness is complete. Vercel previews stay noindex.
SITE_RELEASE_APPROVED=false

# 1. Website publication prerequisites (required to publish the Coming Soon promotional website).
# Leave unknown values empty; never invent them.
DOMAIN_OWNERSHIP_VERIFIED=false
SUPPORT_EMAIL_MONITORED=false
WEBSITE_PRIVACY_APPROVED=false
LEGAL_COPY_APPROVED=false
KVKK_LEGAL_REVIEW_APPROVED=false
MARKETING_COPY_APPROVED=false
LEGAL_EMAIL_PROVIDER=
LEGAL_EMAIL_PROCESSING=
LEGAL_SUPPORT_RETENTION=
LEGAL_HOSTING_PROVIDER=
LEGAL_HOSTING_PROCESSING=
LEGAL_HOSTING_RETENTION=
LEGAL_OPERATOR_ADDRESS=
LEGAL_PUBLICATION_DATE=
LEGAL_RIGHTS_PROCESS=
LEGAL_RIGHTS_CHANNEL=
LEGAL_KVKK_LOCAL_BASIS=
LEGAL_KVKK_SUPPORT_BASIS=
LEGAL_KVKK_HOSTING_BASIS=

# 2. Separate iOS App Store release readiness prerequisites (required before App Store submission, not required merely to publish the Coming Soon promotional website).
IOS_RELEASE_AUDIT_APPROVED=false
FINAL_PRIVACY_INVENTORY_APPROVED=false
FAMILY_CONTROLS_ENTITLEMENT_VERIFIED=false
