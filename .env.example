# Local / Preview defaults. Set true in Netlify's Production context only.
SITE_PUBLICATION_APPROVED=false
# Actual owned Netlify primary HTTPS URL or verified custom domain; no path.
NEXT_PUBLIC_SITE_URL=
# Actual legal document date confirmed by the developer; never build/deploy time.
LEGAL_PUBLICATION_DATE=2026-10-30
# NETLIFY, CONTEXT, DEPLOY_PRIME_URL and DEPLOY_URL are supplied by Netlify.
